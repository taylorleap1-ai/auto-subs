 console.log('Subtitle edit regression checks passed.');
+
+// Reassigning a cue to another speaker survives a reformat, even though its text is unchanged.
+const speakerPair = [cue('Hello there'), { ...cue('General Kenobi', ['General', 'Kenobi'], 2), speaker_id: '2' }];
+assert.equal(preserveSubtitleEdits(speakerPair, speakerPair).changed, false);
+const reassignedCue = preserveSubtitleEdits(speakerPair, [speakerPair[0], { ...speakerPair[1], speaker_id: '1' }]);
+assert.equal(reassignedCue.changed, true);
+assert.deepEqual(reassignedCue.segments.map(segment => segment.speaker_id), ['1', '1']);
+assert.deepEqual(words(reassignedCue.segments), ['Hello', 'there', 'General', 'Kenobi']);
+// Timing and spelling of the reassignedCue words are untouched.
+assert.deepEqual(reassignedCue.segments[1].words, speakerPair[1].words);
+// Reassigning only half of a source group splits it by speaker.
+const speakerGroup = [cue('one two three four')];
+const halfReassigned = preserveSubtitleEdits(speakerGroup, [
+    { ...speakerGroup[0], text: 'one two', words: speakerGroup[0].words.slice(0, 2) },
+    { ...speakerGroup[0], id: 1, text: 'three four', words: speakerGroup[0].words.slice(2), speaker_id: '2' },
+]);
+assert.deepEqual(halfReassigned.segments.map(segment => [segment.speaker_id, segment.text]), [['1', 'one two'], ['2', 'three four']]);
+// A missing speaker is not a difference between null, undefined and an empty id.
+const unlabeledCue = [{ ...cue('no speaker here'), speaker_id: undefined }];
+assert.equal(preserveSubtitleEdits(unlabeledCue, [{ ...unlabeledCue[0], speaker_id: '' }]).changed, false);
