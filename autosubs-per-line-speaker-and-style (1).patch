new file mode 100644
index 0000000..3d4e2ce
--- /dev/null
+++ b/AutoSubs-App/src/lib/line-styles.ts
@@ -0,0 +1,113 @@
+import type { CaptionPreset, PresetOverride, Subtitle } from "@/types";
+
+/**
+ * Per-line caption style overrides.
+ *
+ * An override pins one caption style to a stretch of the transcript: either an
+ * AutoSubs caption preset, or one of the user's own Text+ titles from the
+ * Resolve media pool. Overrides are matched to cues by time (the cue's midpoint
+ * falling inside the override's range) so they keep working after the cues are
+ * re-split or renumbered by a reformat.
+ *
+ * Both kinds are stored in the same `presetId` field. A Text+ title is written
+ * as "title:<clip name>", so overrides saved before titles were supported (plain
+ * preset ids) keep working unchanged.
+ */
+
+const TITLE_PREFIX = "title:";
+
+/** The stored value that pins a Resolve Text+ title (by its media pool name). */
+export const titleStyleValue = (templateName: string) => TITLE_PREFIX + templateName;
+
+/** The media pool title name inside a stored value, or undefined for a preset id. */
+export function parseTitleStyle(value: string | undefined): string | undefined {
+    if (typeof value !== "string" || !value.startsWith(TITLE_PREFIX)) return undefined;
+    const name = value.slice(TITLE_PREFIX.length);
+    return name === "" ? undefined : name;
+}
+
+const midpoint = (cue: { start: number; end: number }) =>
+    (Number(cue.start) + Number(cue.end)) / 2;
+
+const covers = (override: PresetOverride, time: number) =>
+    time >= override.start && time <= override.end;
+
+/** The preset id pinned to this cue, if any. */
+export function findPresetOverride(
+    overrides: ReadonlyArray<PresetOverride> | undefined,
+    cue: { start: number; end: number },
+): string | undefined {
+    if (!overrides?.length) return undefined;
+    const time = midpoint(cue);
+    // Later entries win, so a newer assignment shadows an older overlapping one.
+    for (let i = overrides.length - 1; i >= 0; i--) {
+        if (covers(overrides[i], time)) return overrides[i].presetId;
+    }
+    return undefined;
+}
+
+/**
+ * Pin `presetId` to a cue, or clear its override when `presetId` is undefined.
+ * Any override already attached to this cue is replaced rather than stacked.
+ */
+export function setPresetOverride(
+    overrides: ReadonlyArray<PresetOverride> | undefined,
+    cue: { start: number; end: number },
+    presetId: string | undefined,
+): PresetOverride[] {
+    const time = midpoint(cue);
+    const kept = (overrides ?? []).filter(
+        (o) => !covers(o, time) && !(midpoint(o) >= cue.start && midpoint(o) <= cue.end),
+    );
+    if (presetId === undefined) return kept;
+    return [...kept, { start: Number(cue.start), end: Number(cue.end), presetId }];
+}
+
+/** What the Lua server needs to style individual cues differently. */
+export interface LineStyles {
+    /** Subtitle id (as a string) -> preset id. */
+    segmentPresets: Record<string, string>;
+    /** Preset id -> macro settings, for the presets actually in use. */
+    presetLibrary: Record<string, Record<string, unknown>>;
+    /** Subtitle id (as a string) -> media pool Text+ title name. */
+    segmentTemplates: Record<string, string>;
+}
+
+/**
+ * Resolve the overrides for the current cues into the payload sent to Resolve.
+ * Presets that no longer exist are dropped, so those cues fall back to the
+ * style chosen at send time instead of failing.
+ */
+export function buildLineStyles(
+    subtitles: ReadonlyArray<Subtitle>,
+    overrides: ReadonlyArray<PresetOverride> | undefined,
+    getPreset: (id: string) => CaptionPreset | undefined,
+): LineStyles | undefined {
+    if (!overrides?.length) return undefined;
+
+    const segmentPresets: Record<string, string> = {};
+    const presetLibrary: LineStyles["presetLibrary"] = {};
+    const segmentTemplates: Record<string, string> = {};
+
+    for (const cue of subtitles) {
+        const pinned = findPresetOverride(overrides, cue);
+        if (!pinned) continue;
+
+        const titleName = parseTitleStyle(pinned);
+        if (titleName !== undefined) {
+            // A title that was since deleted from the media pool is handled on
+            // the Resolve side, which falls back to the send-time style.
+            segmentTemplates[String(cue.id)] = titleName;
+            continue;
+        }
+
+        const preset = getPreset(pinned);
+        if (!preset) continue;
+        segmentPresets[String(cue.id)] = pinned;
+        presetLibrary[pinned] = preset.macroSettings;
+    }
+
+    return Object.keys(segmentPresets).length > 0 || Object.keys(segmentTemplates).length > 0
+        ? { segmentPresets, presetLibrary, segmentTemplates }
+        : undefined;
+}
