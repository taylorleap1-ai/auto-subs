+-- Which media pool clip each subtitle is placed from. By default every line
+-- uses the batch template; a line can instead be pinned to one of the user's
+-- own Text+ titles (segmentTemplates: subtitle id -> clip name), or to an
+-- AutoSubs preset (segmentPresets), which needs the animated macro even when the
+-- batch is a Text+ title.
+--
+-- Returns a function (subtitle) -> mediaPoolItem, frameRate, templateName.
+-- A title that cannot be found falls back to the batch template instead of
+-- failing the whole send, and each distinct title is looked up only once since
+-- every lookup scans the media pool.
+local function make_line_template_resolver(rootFolder, timeline, defaultItem, defaultFps, defaultName,
+                                           segmentTemplates, segmentPresets, presetLibrary)
+    local found = {}
+
+    local function lookup(name)
+        local hit = found[name]
+        if hit == nil then
+            local item = get_template_item(rootFolder, name)
+            if not item and caption_style.is_autosubs_template(name) then
+                -- The macro was deleted from this project: import it again.
+                ensure_default_template(rootFolder)
+                item = get_template_item(rootFolder, name)
+            end
+            if item then
+                hit = {
+                    item = item,
+                    fps = template_frame_rate_of(item, timeline),
+                    name = resolve_template_name(name),
+                }
+            else
+                print("[AutoSubs] Per-line template '" .. tostring(name) ..
+                    "' not found in the media pool; using the batch template for those lines")
+                hit = false
+            end
+            found[name] = hit
+        end
+        return hit or nil
+    end
+
+    local hasTitles = type(segmentTemplates) == "table" and next(segmentTemplates) ~= nil
+    local hasPresets = type(segmentPresets) == "table" and type(presetLibrary) == "table"
+        and next(segmentPresets) ~= nil
+
+    return function(subtitle)
+        if (hasTitles or hasPresets) and subtitle ~= nil and subtitle.id ~= nil then
+            local key = tostring(subtitle.id)
+
+            if hasTitles then
+                local titleName = segmentTemplates[key]
+                if type(titleName) == "string" and titleName ~= "" then
+                    local hit = lookup(titleName)
+                    if hit then return hit.item, hit.fps, hit.name end
+                end
+            end
+
+            if hasPresets and not caption_style.is_autosubs_template(defaultName) then
+                local presetId = segmentPresets[key]
+                if presetId ~= nil and type(presetLibrary[presetId]) == "table" then
+                    local hit = lookup(ANIMATED_CAPTION)
+                    if hit then return hit.item, hit.fps, hit.name end
+                end
+            end
+        end
+        return defaultItem, defaultFps, defaultName
+    end
+end
