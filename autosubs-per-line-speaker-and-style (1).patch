+-- Per-line preset overrides and speaker reassignment ------------------------
+do
+    local function applied_settings(trackIdx)
+        local out = {}
+        for _, it in ipairs(tl.tracks[trackIdx].items) do
+            out[#out + 1] = it.handle._comp.tools.AutoSubs.__applied
+        end
+        return out
+    end
+
+    local function seg(id, s, e, speaker)
+        return { id = id, start = s, ["end"] = e, text = "line " .. id, speaker_id = speaker, words = {} }
+    end
+
+    -- A line pinned to its own preset gets that preset; the rest keep the batch style.
+    do
+        local r = run("per-line preset", {
+            subs = { { 0, 1 }, { 1.2, 2 }, { 2.1, 3 } },
+            reqExtra = {
+                subtitleData = { transcriptId = "tx-1", segments = { seg(0, 0, 1), seg(1, 1.2, 2), seg(2, 2.1, 3) } },
+                presetSettings = { Font = "Batch" },
+                segmentPresets = { ["1"] = "pop" },
+                presetLibrary = { pop = { Font = "Pop" } },
+            },
+        })
+        local got = applied_settings(1)
+        check(r and r.ok == true, "per-line preset: ok", tostring(r and r.error))
+        check(got[1] and got[1].Font == "Batch", "unpinned line 1 keeps the batch style", got[1] and got[1].Font)
+        check(got[2] and got[2].Font == "Pop", "pinned line 2 uses its own preset", got[2] and got[2].Font)
+        check(got[3] and got[3].Font == "Batch", "unpinned line 3 keeps the batch style", got[3] and got[3].Font)
+    end
+
+    -- A pinned preset that no longer exists falls back instead of failing.
+    do
+        local r = run("pinned preset deleted", {
+            subs = { { 0, 1 }, { 1.2, 2 } },
+            reqExtra = {
+                subtitleData = { transcriptId = "tx-1", segments = { seg(0, 0, 1), seg(1, 1.2, 2) } },
+                presetSettings = { Font = "Batch" },
+                segmentPresets = { ["0"] = "gone" },
+                presetLibrary = { pop = { Font = "Pop" } },
+            },
+        })
+        local got = applied_settings(1)
+        check(r and r.ok == true, "missing preset: ok", tostring(r and r.error))
+        check(got[1] and got[1].Font == "Batch", "missing preset falls back to the batch style", got[1] and got[1].Font)
+    end
+
+    -- No overrides in the request behaves exactly as before.
+    do
+        local r = run("no overrides", {
+            subs = { { 0, 1 }, { 1.2, 2 } },
+            reqExtra = {
+                subtitleData = { transcriptId = "tx-1", segments = { seg(0, 0, 1), seg(1, 1.2, 2) } },
+                presetSettings = { Font = "Batch" },
+            },
+        })
+        local got = applied_settings(1)
+        check(r and r.ok == true and got[1].Font == "Batch" and got[2].Font == "Batch", "no overrides leaves every line on the batch style")
+    end
+
+    -- Reassigning the first line to the second speaker must not swap the speakers'
+    -- colours. The speakers array is ordered by the raw transcript, where "0" speaks
+    -- first, even though the displayed segments now start with "1".
+    do
+        local speakers = {
+            { name = "A", style = "Fill", color = "#ff0000" },
+            { name = "B", style = "Fill", color = "#00ff00" },
+        }
+        local r = run("speaker reassigned", {
+            subs = { { 0, 1 }, { 1.2, 2 } },
+            reqExtra = {
+                subtitleData = {
+                    transcriptId = "tx-1",
+                    speakers = speakers,
+                    originalSegments = { seg(0, 0, 1, "0"), seg(1, 1.2, 2, "1") },
+                    segments = { seg(0, 0, 1, "1"), seg(1, 1.2, 2, "0") },
+                },
+                presetSettings = { Font = "Batch" },
+            },
+        })
+        local got = applied_settings(1)
+        check(r and r.ok == true, "speaker reassigned: ok", tostring(r and r.error))
+        check(got[1] and got[1].FillColorGreen == 1 and got[1].FillColorRed == 0,
+            "line reassigned to speaker B gets B's colour")
+        check(got[2] and got[2].FillColorRed == 1 and got[2].FillColorGreen == 0,
+            "line left on speaker A keeps A's colour")
+    end
+
+    -- A pinned preset and a speaker colour combine: preset first, colour on top.
+    do
+        local speakers = { { name = "A", style = "Fill", color = "#ff0000" } }
+        local r = run("preset plus speaker colour", {
+            subs = { { 0, 1 } },
+            reqExtra = {
+                subtitleData = {
+                    transcriptId = "tx-1",
+                    speakers = speakers,
+                    originalSegments = { seg(0, 0, 1, "0") },
+                    segments = { seg(0, 0, 1, "0") },
+                },
+                presetSettings = { Font = "Batch" },
+                segmentPresets = { ["0"] = "pop" },
+                presetLibrary = { pop = { Font = "Pop" } },
+            },
+        })
+        local got = applied_settings(1)
+        check(r and r.ok == true and got[1].Font == "Pop" and got[1].FillColorRed == 1,
+            "pinned preset keeps the speaker's colour")
+    end
+end
+
+-- Per-line Text+ titles from the media pool ----------------------------------
+do
+    local function seg(id, s_, e, speaker)
+        return { id = id, start = s_, ["end"] = e, text = "line " .. id, speaker_id = speaker, words = {} }
+    end
+
+    local function item_of(trackIdx, n) return tl.tracks[trackIdx].items[n].handle end
+    local function from_title(trackIdx, n, name)
+        return item_of(trackIdx, n)._source == mp.extraClipByName[name]
+    end
+    local function from_macro(trackIdx, n)
+        return item_of(trackIdx, n)._source == mp.templateClip
+    end
+    local function tools(trackIdx, n) return item_of(trackIdx, n)._comp.tools end
+
+    -- A line pinned to a Text+ title is placed from that title and gets only its
+    -- text; its neighbours stay on the animated macro with the batch style.
+    do
+        local r = run("per-line title", {
+            subs = { { 0, 1 }, { 1.2, 2 }, { 2.1, 3 } },
+            pool = { extraClips = { "Big Yellow" } },
+            reqExtra = {
+                subtitleData = { transcriptId = "tx-1", segments = { seg(0, 0, 1), seg(1, 1.2, 2), seg(2, 2.1, 3) } },
+                presetSettings = { Font = "Batch" },
+                segmentTemplates = { ["1"] = "Big Yellow" },
+            },
+        })
+        check(r and r.ok == true, "per-line title: ok", tostring(r and r.error))
+        check(#tl.tracks[1].items == 3, "per-line title: 3 clips placed", #tl.tracks[1].items)
+        check(from_macro(1, 1) and from_macro(1, 3), "unpinned lines come from the AutoSubs macro")
+        check(from_title(1, 2, "Big Yellow"), "pinned line comes from the Text+ title")
+        check(tools(1, 2).Template._inputs.StyledText == "line 1", "title line gets its text",
+            tostring(tools(1, 2).Template._inputs.StyledText))
+        check(tools(1, 2).AutoSubs.__applied == nil, "title line is not given macro settings")
+        check(tools(1, 1).AutoSubs.__applied and tools(1, 1).AutoSubs.__applied.Font == "Batch",
+            "macro lines keep the batch style")
+    end
+
+    -- The batch is a Text+ title; one line is pinned to an AutoSubs preset, so it
+    -- must come from the animated macro and take that preset.
+    do
+        local r = run("preset line in a title batch", {
+            subs = { { 0, 1 }, { 1.2, 2 } },
+            pool = { extraClips = { "Big Yellow" } },
+            reqExtra = {
+                templateName = "Big Yellow",
+                subtitleData = { transcriptId = "tx-1", segments = { seg(0, 0, 1), seg(1, 1.2, 2) } },
+                segmentPresets = { ["0"] = "pop" },
+                presetLibrary = { pop = { Font = "Pop" } },
+            },
+        })
+        check(r and r.ok == true, "preset in title batch: ok", tostring(r and r.error))
+        check(from_macro(1, 1), "preset-pinned line comes from the AutoSubs macro")
+        check(tools(1, 1).AutoSubs.__applied and tools(1, 1).AutoSubs.__applied.Font == "Pop",
+            "preset-pinned line takes its preset")
+        check(from_title(1, 2, "Big Yellow"), "unpinned line stays on the batch title")
+        check(tools(1, 2).Template._inputs.StyledText == "line 1", "batch title line gets its text")
+    end
+
+    -- A pinned title that is gone from the media pool falls back to the batch
+    -- template instead of failing the whole send.
+    do
+        local r = run("pinned title deleted", {
+            subs = { { 0, 1 }, { 1.2, 2 } },
+            reqExtra = {
+                subtitleData = { transcriptId = "tx-1", segments = { seg(0, 0, 1), seg(1, 1.2, 2) } },
+                presetSettings = { Font = "Batch" },
+                segmentTemplates = { ["0"] = "Deleted Title" },
+            },
+        })
+        check(r and r.ok == true, "missing title: ok", tostring(r and r.error))
+        check(#tl.tracks[1].items == 2, "missing title: both lines still placed", #tl.tracks[1].items)
+        check(from_macro(1, 1), "line with a missing title falls back to the batch template")
+        check(tools(1, 1).AutoSubs.__applied and tools(1, 1).AutoSubs.__applied.Font == "Batch",
+            "fallback line gets the batch style")
+    end
+
+    -- A title and a speaker colour combine: the title line still gets its
+    -- speaker's colour on the Text+ style slot.
+    do
+        local speakers = { { name = "A", style = "Fill", color = "#ff0000" } }
+        local r = run("title plus speaker colour", {
+            subs = { { 0, 1 } },
+            pool = { extraClips = { "Big Yellow" } },
+            reqExtra = {
+                subtitleData = {
+                    transcriptId = "tx-1",
+                    speakers = speakers,
+                    originalSegments = { seg(0, 0, 1, "0") },
+                    segments = { seg(0, 0, 1, "0") },
+                },
+                segmentTemplates = { ["0"] = "Big Yellow" },
+            },
+        })
+        check(r and r.ok == true, "title + speaker: ok", tostring(r and r.error))
+        check(from_title(1, 1, "Big Yellow"), "title + speaker: placed from the title")
+        check(tools(1, 1).Template._inputs.Red1 == 1, "title line keeps the speaker's colour",
+            tostring(tools(1, 1).Template._inputs.Red1))
+    end
+
+    -- Several lines can share a title and each distinct title is placed correctly.
+    do
+        local r = run("two titles", {
+            subs = { { 0, 1 }, { 1.2, 2 }, { 2.1, 3 }, { 3.2, 4 } },
+            pool = { extraClips = { "Big Yellow", "Lower Third" } },
+            reqExtra = {
+                subtitleData = {
+                    transcriptId = "tx-1",
+                    segments = { seg(0, 0, 1), seg(1, 1.2, 2), seg(2, 2.1, 3), seg(3, 3.2, 4) },
+                },
+                presetSettings = { Font = "Batch" },
+                segmentTemplates = { ["0"] = "Big Yellow", ["1"] = "Lower Third", ["3"] = "Big Yellow" },
+            },
+        })
+        check(r and r.ok == true, "two titles: ok", tostring(r and r.error))
+        check(from_title(1, 1, "Big Yellow") and from_title(1, 2, "Lower Third")
+            and from_macro(1, 3) and from_title(1, 4, "Big Yellow"),
+            "each line comes from the template it was pinned to")
+    end
+end
+
 print(string.format("\n%d passed, %d failed", PASS, FAIL))
