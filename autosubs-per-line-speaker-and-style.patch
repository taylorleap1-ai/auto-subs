@@ -0,0 +1,36 @@
+import { toast } from "sonner";
+import i18n from "@/i18n";
+
+/**
+ * Show what the title-animation fitting did, with a button to copy it.
+ *
+ * The Resolve script's own output is not visible in the free edition of
+ * Resolve, so the details come back with the result and are shown here. The
+ * notification stays until it is dismissed so it cannot be missed.
+ */
+export function showKeyframeReport(report: string | null | undefined) {
+  if (!report) return;
+
+  toast.info(i18n.t("captions.keyframeReport.title"), {
+    description: i18n.t("captions.keyframeReport.description"),
+    duration: Infinity,
+    closeButton: true,
+    action: {
+      label: i18n.t("captions.keyframeReport.copy"),
+      onClick: async () => {
+        try {
+          await navigator.clipboard.writeText(report);
+          toast.success(i18n.t("captions.keyframeReport.copied"));
+        } catch (err) {
+          console.error("Could not copy the title animation details:", err);
+          // Show the text itself so it can be read or photographed instead.
+          toast.error(i18n.t("captions.keyframeReport.copyFailed"), {
+            description: report,
+            duration: Infinity,
+            closeButton: true,
+          });
+        }
+      },
+    },
+  });
+}
