diff --git a/AutoSubs-App/scripts/line-styles.test.ts b/AutoSubs-App/scripts/line-styles.test.ts
new file mode 100644
index 0000000..0fc0c12
--- /dev/null
+++ b/AutoSubs-App/scripts/line-styles.test.ts
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import { buildLineStyles, findPresetOverride, setPresetOverride } from '../src/lib/line-styles.ts';
+import type { CaptionPreset, PresetOverride, Subtitle } from '../src/types.ts';
+
+const cue = (id: number, start: number, end: number): Subtitle => ({ id, start, end, text: `cue ${id}`, words: [] });
+const preset = (id: string, macroSettings: Record<string, unknown>): CaptionPreset => ({
+    id, name: id, builtIn: false, version: 1, createdAt: '', updatedAt: '', macroSettings,
+});
+const presets = new Map([['pop', preset('pop', { Font: 'Pop' })], ['slide', preset('slide', { Font: 'Slide' })]]);
+const getPreset = (id: string) => presets.get(id);
+
+// A cue with no overrides has no preset.
+assert.equal(findPresetOverride(undefined, cue(0, 0, 2)), undefined);
+assert.equal(findPresetOverride([], cue(0, 0, 2)), undefined);
+
+// Assigning pins a preset to that cue only.
+let overrides = setPresetOverride([], cue(1, 2, 4), 'pop');
+assert.equal(findPresetOverride(overrides, cue(1, 2, 4)), 'pop');
+assert.equal(findPresetOverride(overrides, cue(0, 0, 2)), undefined);
+assert.equal(findPresetOverride(overrides, cue(2, 4, 6)), undefined);
+
+// Re-assigning replaces rather than stacks.
+overrides = setPresetOverride(overrides, cue(1, 2, 4), 'slide');
+assert.equal(overrides.length, 1);
+assert.equal(findPresetOverride(overrides, cue(1, 2, 4)), 'slide');
+
+// Choosing the default clears the override.
+assert.deepEqual(setPresetOverride(overrides, cue(1, 2, 4), undefined), []);
+
+// An override survives a reformat that re-splits and renumbers the cues.
+const pinned = setPresetOverride([], cue(1, 2, 6), 'pop');
+assert.equal(findPresetOverride(pinned, cue(7, 2, 4)), 'pop');
+assert.equal(findPresetOverride(pinned, cue(8, 4, 6)), 'pop');
+assert.equal(findPresetOverride(pinned, cue(9, 6.5, 8)), undefined);
+
+// A new assignment shadows an older one it overlaps, and clearing it leaves neighbours alone.
+const neighbours: PresetOverride[] = [
+    ...setPresetOverride([], cue(0, 0, 2), 'pop'),
+];
+const both = setPresetOverride(neighbours, cue(1, 2, 4), 'slide');
+assert.equal(findPresetOverride(both, cue(0, 0, 2)), 'pop');
+assert.equal(findPresetOverride(both, cue(1, 2, 4)), 'slide');
+assert.equal(findPresetOverride(setPresetOverride(both, cue(1, 2, 4), undefined), cue(0, 0, 2)), 'pop');
+
+// The Resolve payload only carries overridden cues and the presets they use.
+const subs = [cue(0, 0, 2), cue(1, 2, 4), cue(2, 4, 6)];
+const styles = buildLineStyles(subs, both, getPreset);
+assert.deepEqual(styles?.segmentPresets, { '0': 'pop', '1': 'slide' });
+assert.deepEqual(Object.keys(styles?.presetLibrary ?? {}).sort(), ['pop', 'slide']);
+assert.deepEqual(styles?.presetLibrary.pop, { Font: 'Pop' });
+
+// Nothing to send means nothing is sent.
+assert.equal(buildLineStyles(subs, [], getPreset), undefined);
+assert.equal(buildLineStyles(subs, undefined, getPreset), undefined);
+
+// A deleted preset falls back to the send-time style instead of failing.
+const stale = buildLineStyles(subs, [{ start: 0, end: 2, presetId: 'gone' }], getPreset);
+assert.equal(stale, undefined);
+const partial = buildLineStyles(subs, [{ start: 0, end: 2, presetId: 'gone' }, { start: 2, end: 4, presetId: 'pop' }], getPreset);
+assert.deepEqual(partial?.segmentPresets, { '1': 'pop' });
