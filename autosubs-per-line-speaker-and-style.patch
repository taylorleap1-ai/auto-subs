new file mode 100644
index 0000000..5c3a214
--- /dev/null
+++ b/AutoSubs-App/src/lib/line-styles.ts
@@ -0,0 +1,84 @@
+import type { CaptionPreset, PresetOverride, Subtitle } from "@/types";
+
+/**
+ * Per-line caption style overrides.
+ *
+ * An override pins one AutoSubs caption preset to a stretch of the transcript.
+ * Overrides are matched to cues by time (the cue's midpoint falling inside the
+ * override's range) so they keep working after the cues are re-split or
+ * renumbered by a reformat.
+ */
+
+const midpoint = (cue: { start: number; end: number }) =>
+    (Number(cue.start) + Number(cue.end)) / 2;
+
+const covers = (override: PresetOverride, time: number) =>
+    time >= override.start && time <= override.end;
+
+/** The preset id pinned to this cue, if any. */
+export function findPresetOverride(
+    overrides: ReadonlyArray<PresetOverride> | undefined,
+    cue: { start: number; end: number },
+): string | undefined {
+    if (!overrides?.length) return undefined;
+    const time = midpoint(cue);
+    // Later entries win, so a newer assignment shadows an older overlapping one.
+    for (let i = overrides.length - 1; i >= 0; i--) {
+        if (covers(overrides[i], time)) return overrides[i].presetId;
+    }
+    return undefined;
+}
+
+/**
+ * Pin `presetId` to a cue, or clear its override when `presetId` is undefined.
+ * Any override already attached to this cue is replaced rather than stacked.
+ */
+export function setPresetOverride(
+    overrides: ReadonlyArray<PresetOverride> | undefined,
+    cue: { start: number; end: number },
+    presetId: string | undefined,
+): PresetOverride[] {
+    const time = midpoint(cue);
+    const kept = (overrides ?? []).filter(
+        (o) => !covers(o, time) && !(midpoint(o) >= cue.start && midpoint(o) <= cue.end),
+    );
+    if (presetId === undefined) return kept;
+    return [...kept, { start: Number(cue.start), end: Number(cue.end), presetId }];
+}
+
+/** What the Lua server needs to style individual cues differently. */
+export interface LineStyles {
+    /** Subtitle id (as a string) -> preset id. */
+    segmentPresets: Record<string, string>;
+    /** Preset id -> macro settings, for the presets actually in use. */
+    presetLibrary: Record<string, Record<string, unknown>>;
+}
+
+/**
+ * Resolve the overrides for the current cues into the payload sent to Resolve.
+ * Presets that no longer exist are dropped, so those cues fall back to the
+ * style chosen at send time instead of failing.
+ */
+export function buildLineStyles(
+    subtitles: ReadonlyArray<Subtitle>,
+    overrides: ReadonlyArray<PresetOverride> | undefined,
+    getPreset: (id: string) => CaptionPreset | undefined,
+): LineStyles | undefined {
+    if (!overrides?.length) return undefined;
+
+    const segmentPresets: Record<string, string> = {};
+    const presetLibrary: LineStyles["presetLibrary"] = {};
+
+    for (const cue of subtitles) {
+        const presetId = findPresetOverride(overrides, cue);
+        if (!presetId) continue;
+        const preset = getPreset(presetId);
