+        check(counts_are(back, { replaced = 1, unchanged = 2 }), "sync/title: unpinning swaps it back")
+        check(item_at(1, F2) and item_at(1, F2)._source == mp.templateClip, "sync/title: back on the macro")
+    end
+
+    -- A line added at the end, and the last line removed.
+    do
+        print("\n=== sync: line added ===")
+        fresh()
+        send(three())
+        local segs = three()
+        segs[#segs + 1] = seg(3, 6, 7)
+        local r = sync(segs)
+        local good, why = counts_are(r, { added = 1, unchanged = 3 })
+        check(r.ok == true and good, "sync/add: one added, three untouched", why or tostring(r.error))
+        check(count_on(1) == 4 and item_at(1, 144) ~= nil, "sync/add: the new line is on the timeline", count_on(1))
+    end
+    do
+        print("\n=== sync: last line removed ===")
+        fresh()
+        send(three())
+        local h1 = item_at(1, F1)
+        local segs = three()
+        table.remove(segs)
+        local r = sync(segs)
+        -- The line before it had been joined to the one that is gone, so it
+        -- reverts to its own length: that is a replacement, as a full resend
+        -- would produce.
+        local good, why = counts_are(r, { removed = 1, replaced = 1, unchanged = 1 })
+        check(r.ok == true and good, "sync/remove: one removed, its neighbour re-timed", why or tostring(r.error))
+        check(count_on(1) == 2 and item_at(1, F3) == nil, "sync/remove: the line is gone", count_on(1))
+        check(item_at(1, F1) == h1, "sync/remove: an unrelated line is untouched")
+    end
+
+    -- Reassigning a line to another speaker on the same track recolours it in place.
+    do
+        print("\n=== sync: speaker reassigned (same track) ===")
+        fresh()
+        local speakers = function()
+            return {
+                { name = "A", style = "Fill", color = "#ff0000", track = "1" },
+                { name = "B", style = "Fill", color = "#00ff00", track = "1" },
+            }
+        end
+        local original = { seg(0, 0, 1, nil, "0"), seg(1, 1.25, 2, nil, "1"), seg(2, 2.25, 3, nil, "0") }
+        local docExtra = function() return { speakers = speakers(), originalSegments = original } end
+        send(original, nil, docExtra())
+        local h1 = item_at(1, F1)
+        local changed = { seg(0, 0, 1, nil, "1"), seg(1, 1.25, 2, nil, "1"), seg(2, 2.25, 3, nil, "0") }
+        local r = sync(changed, nil, docExtra())
+        local good, why = counts_are(r, { restyled = 1, unchanged = 2 })
+        check(r.ok == true and good, "sync/speaker: one line recoloured", why or tostring(r.error))
+        check(item_at(1, F1) == h1, "sync/speaker: same clip, restyled in place")
+        local applied = h1._comp.tools.AutoSubs.__applied
+        check(applied and applied.FillColorGreen == 1 and applied.FillColorRed == 0,
+            "sync/speaker: it now has the other speaker's colour")
+    end
+
+    -- With one track per speaker, a reassigned line moves to its new speaker's track.
+    do
+        print("\n=== sync: speaker reassigned (own tracks) ===")
+        fresh { trackCount = 2 }
+        local speakers = function()
+            return {
+                { name = "A", style = "Fill", color = "#ff0000", track = "1" },
+                { name = "B", style = "Fill", color = "#00ff00", track = "2" },
+            }
+        end
+        local original = { seg(0, 0, 1, nil, "0"), seg(1, 1.25, 2, nil, "1") }
+        local docExtra = function() return { speakers = speakers(), originalSegments = original } end
+        send(original, nil, docExtra())
+        check(count_on(1) == 1 and count_on(2) == 1, "sync/move: one clip per speaker track to start")
+        local h2 = item_at(2, F2)
+        local moved = { seg(0, 0, 1, nil, "1"), seg(1, 1.25, 2, nil, "1") }
+        local r = sync(moved, nil, docExtra())
+        check(r.ok == true and r.replaced == 1 and r.added == 0 and r.removed == 0,
+            "sync/move: counted as one replaced", tostring(r.error) .. " " .. tostring(r.replaced))
+        check(count_on(1) == 0 and count_on(2) == 2, "sync/move: the line left track 1 for track 2",
+            count_on(1) .. "/" .. count_on(2))
+        check(item_at(2, F2) == h2, "sync/move: the other speaker's clip was not disturbed")
+        check(#tl.tracks == 2, "sync/move: no track was created", #tl.tracks)
+    end
+
+    -- An older copy kept on its own track is never touched.
+    do
+        print("\n=== sync: copy on another track ===")
+        fresh { trackCount = 2 }
+        send(three())
+        send(three(), { trackIndex = "2" })
+        check(count_on(1) == 3 and count_on(2) == 3, "sync/copy: two copies placed")
+        local copy = { item_at(2, F1), item_at(2, F2), item_at(2, F3) }
+        local edited = three()
+        edited[2].text = "changed"
+        local r = sync(edited)
+        local good, why = counts_are(r, { replaced = 1, unchanged = 2 })
+        check(r.ok == true and good, "sync/copy: only the synced track changed", why or tostring(r.error))
+        check(count_on(2) == 3 and item_at(2, F1) == copy[1] and item_at(2, F2) == copy[2] and item_at(2, F3) == copy[3],
+            "sync/copy: the other copy is exactly as it was")
+    end
+
+    -- Nothing on the timeline yet.
+    do
+        print("\n=== sync: nothing placed ===")
+        fresh()
+        local r = sync(three())
+        check(r.error ~= nil and r.code == "nothing_to_sync", "sync/empty: asks for Add to Timeline first",
+            tostring(r.error) .. " / " .. tostring(r.code))
+        check(count_on(1) == 0, "sync/empty: and places nothing")
+    end
+
+    -- Clips placed before fingerprints existed are restyled, not replaced, and
+    -- then tracked from then on.
+    do
+        print("\n=== sync: clips without fingerprints ===")
+        fresh()
+        send(three())
+        for _, it in ipairs(tl.tracks[1].items) do
+            local data = it.handle._comp.tools.AutoSubs._data
+            data.AutoSubsContentKey, data.AutoSubsStyleKey, data.AutoSubsTemplate = nil, nil, nil
+        end
+        local h1, h2, h3 = item_at(1, F1), item_at(1, F2), item_at(1, F3)
+        local r = sync(three())
+        local good, why = counts_are(r, { restyled = 3 })
+        check(r.ok == true and good, "sync/legacy: unchanged words, so restyled not replaced", why or tostring(r.error))
+        check(item_at(1, F1) == h1 and item_at(1, F2) == h2 and item_at(1, F3) == h3, "sync/legacy: same clips")
+        check(counts_are(sync(three()), { unchanged = 3 }), "sync/legacy: tracked from now on")
+        -- Words that differ from what the clip shows are caught even without a record.
+        for _, it in ipairs(tl.tracks[1].items) do
+            local data = it.handle._comp.tools.AutoSubs._data
+            data.AutoSubsContentKey, data.AutoSubsStyleKey, data.AutoSubsTemplate = nil, nil, nil
+        end
+        local edited = three()
+        edited[1].text = "different words"
+        local r2 = sync(edited)
+        check(r2.ok == true and r2.replaced == 1, "sync/legacy: changed words still caught", tostring(r2.replaced))
+    end
+
+    -- A locked track is unlocked for the work and locked again afterwards.
+    do
+        print("\n=== sync: locked track ===")
+        fresh()
+        send(three())
+        tl.tracks[1].locked = true
+        local edited = three()
+        edited[2].text = "changed"
+        local r = sync(edited)
+        check(r.ok == true and r.replaced == 1, "sync/locked: the edit still lands", tostring(r.error))
+        check(tl.tracks[1].locked == true, "sync/locked: and the track is locked again")
+    end
+
+    -- Lines move down when one is inserted: the clips keep their place, and
+    -- their hidden tags follow the new numbering.
+    do
+        print("\n=== sync: lines renumbered ===")
+        fresh()
+        local base = { seg(0, 1, 2, "a"), seg(1, 3, 4, "b"), seg(2, 5, 6, "c") }
+        send(base)
+        local inserted = { seg(0, 0, 0.5, "new"), seg(1, 1, 2, "a"), seg(2, 3, 4, "b"), seg(3, 5, 6, "c") }
+        local r = sync(inserted)
+        local good, why = counts_are(r, { added = 1, unchanged = 3 })
+        check(r.ok == true and good, "sync/renumber: one added, three untouched", why or tostring(r.error))
+        local second = item_at(1, 24)
+        check(second and second._comp.tools.AutoSubs._data.AutoSubsSegmentIndex == 2,
+            "sync/renumber: the clip's tag follows its new position",
+            second and tostring(second._comp.tools.AutoSubs._data.AutoSubsSegmentIndex))
+    end
+end
+
+-- Fitting a title's animation to the caption it is placed on --------------------
+do
+    local function seg(id, s_, e, text)
+        return { id = id, start = s_, ["end"] = e, text = text or ("line " .. id), words = {} }
+    end
+    local function fresh(poolOpts)
+        tl = make_timeline { trackCount = 1 }
+        mp = make_media_pool(tl, poolOpts or {})
+        wire_project(tl, mp)
+    end
+    local function request(func, segs, extra)
+        local r = {
+            func = func,
+            filePath = "/tmp/luatest/tx.json",
+            trackIndex = "1",
+            templateName = "Big Yellow",
+            subtitleData = { transcriptId = "tx-1", segments = segs },
+            presetSettings = { Font = "Batch" },
+        }
+        for k, v in pairs(extra or {}) do r[k] = v end
+        return r
+    end
+    local function send(segs, extra) return AddSubtitles(request("AddSubtitles", segs, extra)) end
+    local function sync(segs, extra) return SyncSubtitles(request("SyncSubtitles", segs, extra)) end
+    local function times_of(spline)
+        local times = {}
+        for t in pairs(spline._kf) do times[#times + 1] = t end
+        table.sort(times)
+        return times
+    end
+    local function same(a, b)
+        if #a ~= #b then return false end
+        for i = 1, #a do if a[i] ~= b[i] then return false end end
+        return true
+    end
+    local function show(list) return "{" .. table.concat(list, ",") .. "}" end
+    local function near(a, b)
+        if #a ~= #b then return false end
+        for i = 1, #a do if math.abs(a[i] - b[i]) > 0.01 then return false end end
+        return true
+    end
+    -- Two curves are identical: same keyframes, values and handles.
+    local function same_curve(a, b)
+        local ta, tb = times_of(a), times_of(b)
+        if not same(ta, tb) then return false end
+        for _, t in ipairs(ta) do
+            local ka, kb = a._kf[t], b._kf[t]
+            if ka[1] ~= kb[1] then return false end
+            for _, side in ipairs({ "LH", "RH" }) do
+                if (ka[side] == nil) ~= (kb[side] == nil) then return false end
+                if ka[side] and (ka[side][1] ~= kb[side][1] or ka[side][2] ~= kb[side][2]) then return false end
+            end
+        end
+        return true
+    end
+
+    -- An intro (0 to 10) and an outro (100 to 119) on a 5 second, 24 fps title.
+    local function curve()
+        return {
+            [0] = { 0 },
+            [10] = { 1, RH = { 13, 1 } },
+            [100] = { 1, LH = { 97, 1 } },
+            [119] = { 0 },
+        }
+    end
+    -- Three captions of the same length, far enough apart not to be joined.
+    local function captions(seconds)
+        local gap = seconds + 2
+        return { seg(0, 0, seconds), seg(1, gap, gap + seconds), seg(2, gap * 2, gap * 2 + seconds) }
+    end
+    local created
+    local function title_pool(extra)
+        local opts = { extraClips = { "Big Yellow" }, titleFrames = { ["Big Yellow"] = 120 } }
+        for k, v in pairs(extra or {}) do opts[k] = v end
+        fresh(opts)
+        mp.bareTitles = true
+        created = {}
+        mp.titleSplines = function()
+            local sp = make_spline(curve(), "Opacity" .. (#created + 1))
+            created[#created + 1] = sp
+            return { sp }
+        end
+    end
+
+    -- A caption shorter than the title: the intro stays, the outro moves up to the end.
+    do
+        print("\n=== keyframes: shorter caption ===")
+        title_pool()
+        local r = send(captions(1.5))
+        check(r.ok == true, "keyframes/short: sent", tostring(r.error))
+        check(#created == 3, "keyframes/short: three title clips placed", #created)
+        local got = times_of(created[1])
+        check(same(got, { 0, 10, 16, 35 }), "keyframes/short: intro kept, outro moved to the end", show(got))
+        check(created[1]._kf[16][1] == 1 and created[1]._kf[35][1] == 0, "keyframes/short: values travel with their keyframes")
+        check(same(times_of(created[3]), { 0, 10, 16, 35 }), "keyframes/short: every clip is fitted")
+    end
+
+    -- Handles move with their keyframe.
+    do
+        print("\n=== keyframes: handles ===")
+        title_pool()
+        send(captions(1.5))
+        local kf = created[1]._kf
+        check(kf[10].RH[1] == 13 and kf[10].RH[2] == 1, "keyframes/handles: an intro handle is unmoved")
+        check(kf[16].LH and kf[16].LH[1] == 13 and kf[16].LH[2] == 1,
+            "keyframes/handles: an outro handle keeps its distance", kf[16].LH and tostring(kf[16].LH[1]))
+    end
+
+    -- Too short for both: the animation is squeezed to fit.
+    do
+        print("\n=== keyframes: very short caption ===")
+        title_pool()
+        local r = send(captions(20 / 24))
+        check(r.ok == true, "keyframes/tiny: sent", tostring(r.error))
+        local got = times_of(created[1])
+        check(near(got, { 0, 10 / 6, 100 / 6, 119 / 6 }), "keyframes/tiny: squeezed proportionally", show(got))
+        check(created[1]._kf[times_of(created[1])[3]].LH[1] < times_of(created[1])[3],
+            "keyframes/tiny: and its handles still point the right way")
+    end
+
+    -- A caption longer than the title: the outro waits for the end.
+    do
+        print("\n=== keyframes: longer caption ===")
+        title_pool()
+        send(captions(10))
+        local got = times_of(created[1])
+        check(same(got, { 0, 10, 220, 239 }), "keyframes/long: outro pushed out to the end", show(got))
+    end
+
+    -- Switched off: nothing is touched.
+    do
+        print("\n=== keyframes: switched off ===")
+        title_pool()
+        local r = send(captions(1.5), { fitTitleKeyframes = false })
+        check(r.ok == true and created[1].writes == nil, "keyframes/off: animation left exactly as authored")
+        check(same(times_of(created[1]), { 0, 10, 100, 119 }), "keyframes/off: times unchanged")
+    end
+
+    -- The animated macro builds its own keyframes, so it is never retimed.
+    do
+        print("\n=== keyframes: the macro is left alone ===")
+        title_pool()
+        mp.splinesOnAll = true
+        local r = send(captions(1.5), { templateName = "AutoSubs Caption 2026-09-17" })
+        check(r.ok == true and #created >= 1, "keyframes/macro: sent with curves present", tostring(r.error))
+        local touched = 0
+        for _, sp in ipairs(created) do if sp.writes then touched = touched + 1 end end
+        check(touched == 0, "keyframes/macro: none of its curves were retimed", touched)
+    end
+
+    -- Resolve not reporting the template length: assume the outro ends on its last frame.
+    do
+        print("\n=== keyframes: template length unknown ===")
+        title_pool { titleFrames = {} }
+        send(captions(1.5))
+        check(same(times_of(created[1]), { 0, 10, 16, 35 }), "keyframes/unknown: inferred from the animation itself",
+            show(times_of(created[1])))
+    end
+    -- ...or reporting it as a timecode.
+    do
+        print("\n=== keyframes: template length as a timecode ===")
+        title_pool { titleFrames = {}, titleDuration = { ["Big Yellow"] = "00:00:05:00" } }
+        send(captions(1.5))
+        check(same(times_of(created[1]), { 0, 10, 16, 35 }), "keyframes/timecode: read from Duration",
+            show(times_of(created[1])))
+    end
+
+    -- Curves that are not Bezier splines are not touched; the ones that are, are.
+    do
+        print("\n=== keyframes: other curve types ===")
+        title_pool()
+        mp.titleSplines = function()
+            local bezier = make_spline(curve(), "Opacity")
+            local path = make_spline(curve(), "Path", "XYPath")
+            created[#created + 1] = bezier
+            created[#created + 1] = path
+            return { bezier, path }
+        end
+        send(captions(1.5))
+        check(created[1].adjusts == 1 and created[2].adjusts == 0, "keyframes/types: only the Bezier spline is retimed")
+    end
+
+    -- A curve Fusion will not write to must not stop the caption being placed.
+    do
+        print("\n=== keyframes: a refused write ===")
+        title_pool()
+        mp.titleSplines = function()
+            local sp = make_spline(curve(), "Opacity")
+            sp.failWrite = true
+            sp.failAdjust = true
+            created[#created + 1] = sp
+            return { sp }
+        end
+        local r = send(captions(1.5))
+        check(r.ok == true and (r.failed or 0) == 0, "keyframes/refused: the send still succeeds", tostring(r.error))
+        check(#tl.tracks[1].items == 3, "keyframes/refused: all three captions are on the timeline", #tl.tracks[1].items)
+        check(same(times_of(created[1]), { 0, 10, 100, 119 }), "keyframes/refused: the curve is left as it was")
+    end
+
+    -- Fusion's own AdjustKeyFrames is used when it behaves as documented.
+    do
+        print("\n=== keyframes: AdjustKeyFrames ===")
+        title_pool()
+        local r = send(captions(1.5))
+        check(r.ok == true and created[1].adjusts == 1 and created[1].writes == nil,
+            "keyframes/adjust: one AdjustKeyFrames call, no rewrite of the curve")
+    end
+
+    -- A Fusion without AdjustKeyFrames: the curve is rewritten instead, correctly.
+    do
+        print("\n=== keyframes: no AdjustKeyFrames ===")
+        title_pool()
+        mp.titleSplines = function()
+            local sp = make_spline(curve(), "Opacity", nil, { adjust = false })
+            created[#created + 1] = sp
+            return { sp }
+        end
+        local r = send(captions(1.5))
+        check(r.ok == true and created[1].writes == 1, "keyframes/rewrite: the curve is rewritten", tostring(r.error))
+        local kf = created[1]._kf
+        check(same(times_of(created[1]), { 0, 10, 16, 35 }) and kf[16].LH[1] == 13 and kf[35][1] == 0,
+            "keyframes/rewrite: with the right times and handles", show(times_of(created[1])))
+    end
+
+    -- AdjustKeyFrames that leaves the handles behind is noticed and undone; the
+    -- rewrite then does the job.
+    do
+        print("\n=== keyframes: AdjustKeyFrames leaves handles behind ===")
+        title_pool()
+        mp.titleSplines = function()
+            local sp = make_spline(curve(), "Opacity", nil, { adjust = "ignoreHandles" })
+            created[#created + 1] = sp
+            return { sp }
+        end
+        local r = send(captions(1.5))
+        local kf = created[1]._kf
+        check(r.ok == true and created[1].writes == 1, "keyframes/ignore: falls back to rewriting the curve", tostring(r.error))
+        check(same(times_of(created[1]), { 0, 10, 16, 35 }) and kf[16].LH[1] == 13,
+            "keyframes/ignore: and ends up correct", show(times_of(created[1])))
+    end
+
+    -- THE FAILURE SEEN IN FUSION: a rewrite that mangles the handles makes the
+    -- outro loop. It must be detected and the curve put back exactly as it was.
+    do
+        print("\n=== keyframes: a rewrite that damages the curve ===")
+        title_pool()
+        mp.titleSplines = function()
+            local sp = make_spline(curve(), "Opacity", nil, { adjust = false, corruptFirstWrite = true })
+            created[#created + 1] = sp
+            return { sp }
+        end
+        local r = send(captions(1.5))
+        check(r.ok == true and (r.failed or 0) == 0, "keyframes/damage: the send still succeeds", tostring(r.error))
+        check(same_curve(created[1], make_spline(curve(), "x")), "keyframes/damage: the curve is restored exactly as authored")
+    end
+
+    -- Both ways of moving the curve go wrong: still nothing is left damaged.
+    do
+        print("\n=== keyframes: every way goes wrong ===")
+        title_pool()
+        mp.titleSplines = function()
+            local sp = make_spline(curve(), "Opacity", nil, { adjust = "corrupt", corruptFirstWrite = true })
+            created[#created + 1] = sp
+            return { sp }
+        end
+        local r = send(captions(1.5))
+        check(r.ok == true, "keyframes/both: the send still succeeds", tostring(r.error))
+        check(same_curve(created[1], make_spline(curve(), "x")), "keyframes/both: the curve is left as authored")
+    end
+
+    -- A curve that already loops is not blamed on the fit.
+    do
+        print("\n=== keyframes: a curve that already crosses ===")
+        title_pool()
+        mp.titleSplines = function()
+            local crossed = curve()
+            crossed[100].LH = { 140, 1 } -- already wrong in the title itself
+            local sp = make_spline(crossed, "Opacity")
+            created[#created + 1] = sp
+            return { sp }
+        end
+        send(captions(1.5))
+        check(same(times_of(created[1]), { 0, 10, 16, 35 }), "keyframes/preexisting: still fitted", show(times_of(created[1])))
+    end
+
+    -- The details come back with the result, because Resolve's free edition does
+    -- not let the user read a script's output.
+    do
+        print("\n=== keyframes: the report ===")
+        title_pool()
+        local r = send(captions(1.5))
+        local report = r.keyframeReport or ""
+        check(report:find("Keyframe fitting v2", 1, true) ~= nil, "keyframes/report: says which version ran")
+        check(report:find("Title length: 120 frames (reported by Resolve)", 1, true) ~= nil,
+            "keyframes/report: says how long the title is", report)
+        check(report:find("Caption: 36 frames at 24 fps", 1, true) ~= nil, "keyframes/report: and the caption")
+        check(report:find("Fitted 'Opacity1'", 1, true) ~= nil and report:find("0.00=0 | 10.00=1", 1, true) ~= nil,
+            "keyframes/report: shows the keyframes before", report)
+        check(report:find("16.00=1", 1, true) ~= nil and report:find("35.00=0", 1, true) ~= nil,
+            "keyframes/report: and after")
+        check(report:find("across 3 clips", 1, true) ~= nil, "keyframes/report: summarises the whole send")
+    end
+    do
+        print("\n=== keyframes: the report when a curve is restored ===")
+        title_pool()
+        mp.titleSplines = function()
+            local sp = make_spline(curve(), "Opacity", nil, { adjust = false, corruptFirstWrite = true })
+            created[#created + 1] = sp
+            return { sp }
+        end
+        local r = send(captions(1.5))
+        local report = r.keyframeReport or ""
+        check(report:find("did not come out right, so it was restored", 1, true) ~= nil,
+            "keyframes/report: says a curve was restored", report)
+        check(report:find("Before:", 1, true) ~= nil and report:find("After:", 1, true) ~= nil,
+            "keyframes/report: with what Resolve did to it")
+    end
+    do
+        print("\n=== keyframes: no report when nothing was fitted ===")
