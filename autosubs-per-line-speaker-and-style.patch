+-- Handles that cross their neighbours make a curve loop back on itself.
+local function count_crossed_handles(keyframes)
+    local times, crossed = keyframe_times(keyframes), 0
+    for i, time in ipairs(times) do
+        local keyframe = keyframes[time]
+        local left, right = keyframe.LH, keyframe.RH
+        if type(left) == "table" and type(left[1]) == "number"
+            and (left[1] > time + 1e-6 or (times[i - 1] and left[1] < times[i - 1] - 1e-6)) then
+            crossed = crossed + 1
+        end
+        if type(right) == "table" and type(right[1]) == "number"
+            and (right[1] < time - 1e-6 or (times[i + 1] and right[1] > times[i + 1] + 1e-6)) then
+            crossed = crossed + 1
+        end
+    end
+    return crossed
+end
+
+-- Did the curve end up exactly where the plan says? Returns true, or false and why.
+local function check_fit(original, now, plan)
+    local before, after = keyframe_times(original), keyframe_times(now)
+    if #before ~= #after then return false, "the number of keyframes changed" end
+    local factor = plan_factor(plan)
+    for i, time in ipairs(before) do
+        local was, is = original[time], now[after[i]]
+        if math.abs(after[i] - planned_time(plan, time)) > 0.01 then
+            return false, string.format("a keyframe at %.2f went to %.2f instead of %.2f", time, after[i],
+                planned_time(plan, time))
+        end
+        if math.abs((tonumber(is[1]) or 0) - (tonumber(was[1]) or 0)) > 1e-4 then
+            return false, "a keyframe's value changed"
+        end
+        for _, side in ipairs({ "LH", "RH" }) do
+            local handleWas, handleIs = was[side], is[side]
+            if type(handleWas) == "table" and type(handleWas[1]) == "number" then
+                if type(handleIs) ~= "table" or type(handleIs[1]) ~= "number" then
+                    return false, "a handle was lost"
+                end
+                local wanted = (handleWas[1] - time) * factor
+                local got = handleIs[1] - after[i]
+                if math.abs(got - wanted) > 0.05 + 0.02 * math.abs(wanted) then
+                    return false, string.format("a handle is %.2f frames from its keyframe instead of %.2f", got, wanted)
+                end
+                if math.abs((handleIs[2] or 0) - (handleWas[2] or 0)) > 1e-4 then
+                    return false, "a handle's height changed"
+                end
+            end
+        end
+    end
+    if count_crossed_handles(now) > count_crossed_handles(original) then
+        return false, "the handles now cross, which makes the curve loop"
+    end
+    return true
+end
+
+-- A curve's keyframes on one line, for the console.
+local function describe_keyframes(keyframes)
+    local parts = {}
+    for _, time in ipairs(keyframe_times(keyframes)) do
+        local keyframe = keyframes[time]
+        local text = string.format("%.2f=%.3g", time, tonumber(keyframe[1]) or 0)
+        if type(keyframe.LH) == "table" then text = text .. string.format(" LH(%.2f,%.3g)", keyframe.LH[1] or 0, keyframe.LH[2] or 0) end
+        if type(keyframe.RH) == "table" then text = text .. string.format(" RH(%.2f,%.3g)", keyframe.RH[1] or 0, keyframe.RH[2] or 0) end
+        parts[#parts + 1] = text
+    end
+    return table.concat(parts, " | ")
+end
+
+-- Move one curve's keyframes. Returns how many it moved, or 0 and a reason.
+-- Whatever is done is read back and checked, and undone if it is not right, so
+-- a curve is never left damaged.
+local function fit_spline_keyframes(spline, templateFrames, clipFrames, name, log)
+    local readOk, original = pcall(function() return spline:GetKeyFrames() end)
+    if not readOk or type(original) ~= "table" then return 0, "could not read its keyframes" end
+    local times = keyframe_times(original)
+    if #times == 0 then return 0 end
+
+    local plan = plan_fit(times, templateFrames, clipFrames)
+    if not plan then return 0, "the clip is too short to hold the animation" end
+    if plan.op == "none" then return 0 end
+
+    local function show(label)
+        if log and log.remaining > 0 then
+            log.remaining = log.remaining - 1
+            report_line(log, label)
+        end
+    end
+    local function read_now()
+        local ok, now = pcall(function() return spline:GetKeyFrames() end)
+        if ok and type(now) == "table" then return now end
+        return nil
+    end
+    local problems = {}
+
+    -- First choice: Fusion's own AdjustKeyFrames.
+    do
+        local moveOk, moveErr = pcall(adjust_with_fusion, spline, plan, false)
+        if moveOk then
+            local now = read_now()
+            local good, why
+            if now then good, why = check_fit(original, now, plan) else good, why = false, "could not read the curve back" end
+            if good then
+                show(string.format("Fitted '%s': %s  ->  %s", name, describe_keyframes(original), describe_keyframes(now)))
+                return #times
+            end
+            problems[#problems + 1] = "AdjustKeyFrames: " .. tostring(why)
+            -- Put it back before trying anything else.
+            if not pcall(adjust_with_fusion, spline, plan, true) then
+                pcall(function() return spline:SetKeyFrames(original, true) end)
+            end
+        else
+            problems[#problems + 1] = "AdjustKeyFrames failed: " .. tostring(moveErr)
+        end
+    end
+
+    -- Second choice: rewrite the curve.
+    local rewriteOk, rewriteErr = pcall(rebuild_with_keyframes, spline, original, plan)
+    if rewriteOk then
+        local now = read_now()
+        local good, why
+        if now then good, why = check_fit(original, now, plan) else good, why = false, "could not read the curve back" end
+        if good then
+            show(string.format("Fitted '%s': %s  ->  %s", name, describe_keyframes(original), describe_keyframes(now)))
+            return #times
+        end
+        problems[#problems + 1] = "rewriting the curve: " .. tostring(why)
+        report_line(log, string.format("Curve '%s' did not come out right, so it was restored.  Before: %s   After: %s",
+            name, describe_keyframes(original), now and describe_keyframes(now) or "(unreadable)"))
+        pcall(function() return spline:SetKeyFrames(original, true) end)
+    else
+        problems[#problems + 1] = "rewriting the curve failed: " .. tostring(rewriteErr)
+    end
+
+    return 0, table.concat(problems, "; ")
+end
+
+-- Fit every animation curve in a title's comp to a clip of `clipSeconds`.
+-- Returns { curves = n, keyframes = n, reason = first problem or nil }.
+local function fit_title_keyframes(comp, templateSeconds, clipSeconds, fallbackRate, log)
+    local result = { curves = 0, keyframes = 0 }
+    local rateOk, rate = pcall(function() return tonumber(comp:GetPrefs("Comp.FrameFormat.Rate")) end)
+    rate = (rateOk and rate and rate > 0) and rate or tonumber(fallbackRate)
+    if not rate or not clipSeconds or clipSeconds <= 0 then
+        result.reason = "no frame rate or clip length"
+        return result
+    end
+
+    local splines = animated_splines(comp)
+    if #splines == 0 then
+        result.noCurves = true
+        return result
+    end
+    local clipFrames = math.floor(clipSeconds * rate + 0.5)
+
+    -- Resolve does not always report a template's length. Without it, assume
+    -- the outro finishes on the template's last frame.
+    local templateFrames = templateSeconds and math.floor(templateSeconds * rate + 0.5) or nil
+    if not templateFrames then
+        local last = nil
+        for _, spline in ipairs(splines) do
+            local readOk, keyframes = pcall(function() return spline:GetKeyFrames() end)
+            if readOk and type(keyframes) == "table" then
+                local times = keyframe_times(keyframes)
+                if #times > 0 and (last == nil or times[#times] > last) then last = times[#times] end
+            end
+        end
+        templateFrames = last and math.floor(last + 1.5) or nil
+    end
+    if not templateFrames then
+        result.reason = "could not tell how long the title is"
+        return result
+    end
+
+    if log and log.contextRemaining and log.contextRemaining > 0 then
+        log.contextRemaining = log.contextRemaining - 1
+        report_line(log, string.format("Title length: %d frames (%s). Caption: %d frames at %.4g fps. Animation curves found: %d.",
+            templateFrames, templateSeconds and "reported by Resolve" or "guessed from its last keyframe",
+            clipFrames, rate, #splines))
+    end
+
+    for position, spline in ipairs(splines) do
+        local splineName = "curve " .. position
+        pcall(function()
+            local attrs = spline:GetAttrs()
+            if type(attrs) == "table" and attrs.TOOLS_Name then splineName = tostring(attrs.TOOLS_Name) end
+        end)
+        local moved, reason = fit_spline_keyframes(spline, templateFrames, clipFrames, splineName, log)
+        if moved > 0 then
+            result.curves = result.curves + 1
+            result.keyframes = result.keyframes + moved
+        elseif reason and result.reason == nil then
+            result.reason = reason
+        end
+    end
+    return result
+end
+
+-- What apply_subtitle_text needs to fit titles: aligned with the clips it is
+-- given, `which` picking a subset of clipList by index.
+local function build_fit_info(enabled, frame_rate, clipList, clipTimelineEnd, clipTemplateSeconds, which)
+    local info = { enabled = enabled, frameRate = frame_rate, clipSeconds = {}, templateSeconds = {}, log = new_fit_log() }
+    local function add(position, k)
+        local clip = clipList[k]
+        if clip and clipTimelineEnd[k] then
+            info.clipSeconds[position] = (clipTimelineEnd[k] - clip.recordFrame) / frame_rate
+        end
+        info.templateSeconds[position] = clipTemplateSeconds and clipTemplateSeconds[k] or nil
+    end
+    if which then
+        for position, k in ipairs(which) do add(position, k) end
+    else
+        for k = 1, #clipList do add(k, k) end
+    end
+    return info
 end
 
