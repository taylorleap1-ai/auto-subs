+-- The app builds its speakers array in first-appearance order of the raw
+-- transcript, so ids have to be ranked from that same source. Ranking from the
+-- displayed segments is not safe once a segment can be reassigned to another
+-- speaker: that can change which id appears first on screen, which would shift
+-- every speaker's colour and track by one.
+local function speaker_index_for_document(data)
+    local raw = data["originalSegments"] or data["original_segments"]
+    local index = build_speaker_index_by_id(raw)
+    if next(index) == nil then
+        index = build_speaker_index_by_id(data["segments"])
+    end
+    return index
+end
+
+-- Macro settings for one subtitle: the preset pinned to that line if there is
+-- one, otherwise the style chosen for the whole batch. segmentPresets maps a
+-- subtitle id (as a string, since JSON object keys are) to a preset id, and
+-- presetLibrary maps a preset id to its macro settings.
+local function settings_for_subtitle(subtitle, defaultSettings, segmentPresets, presetLibrary)
+    if type(segmentPresets) ~= "table" or type(presetLibrary) ~= "table" then
+        return defaultSettings
+    end
+    if subtitle == nil or subtitle.id == nil then
+        return defaultSettings
+    end
+    local presetId = segmentPresets[tostring(subtitle.id)]
+    local pinned = presetId ~= nil and presetLibrary[presetId] or nil
+    if type(pinned) == "table" then
+        return pinned
+    end
+    return defaultSettings
+end
+
+-- Apply the language-aware font fallback to every preset in the library, the
+-- same way it is applied to the batch-wide preset.
+local function localize_preset_library(presetLibrary, language)
+    if type(presetLibrary) ~= "table" or not font_fallback then
+        return presetLibrary
+    end
+    local out = {}
+    for presetId, settings in pairs(presetLibrary) do
+        out[presetId] = (font_fallback.maybe_override(settings, language))
+    end
+    return out
+end
